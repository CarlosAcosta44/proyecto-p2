// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model p2_usuario {
  id     Int        @id @default(autoincrement())
  nombre String
  rol    String     @default("vigilante")
  rondas p2_ronda[]
}

model p2_punto_control {
  id          Int            @id @default(autoincrement())
  codigo      String         @unique
  nombre      String
  latitud     Float
  longitud    Float
  radio_m     Int            @default(40)
  orden       Int
  marcaciones p2_marcacion[]
}

model p2_ronda {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  Int
  usuario     p2_usuario     @relation(fields: [usuario_id], references: [id])
  inicia_en   DateTime       @default(now()) @db.Timestamptz(6)
  vence_en    DateTime       @db.Timestamptz(6)
  estado      String         @default("en_curso") // en_curso, cerrada
  marcaciones p2_marcacion[]
}

model p2_marcacion {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ronda_id      String           @db.Uuid
  ronda         p2_ronda         @relation(fields: [ronda_id], references: [id])
  punto_id      Int
  punto         p2_punto_control @relation(fields: [punto_id], references: [id])
  latitud       Float
  longitud      Float
  precision_m   Float            @db.Real
  distancia_m   Float            @db.Real
  aceptada      Boolean
  motivo_rechazo String?
  escaneada_en  DateTime         @db.Timestamptz(6)

  @@unique([ronda_id, punto_id])
}

model p1_dispositivo {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identificador  String               @unique
  modelo         String?
  creado_en      DateTime             @default(now()) @db.Timestamptz(6)
  eventos        p1_evento_impacto[]
}

model p1_evento_impacto {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispositivo_id String         @db.Uuid
  dispositivo    p1_dispositivo @relation(fields: [dispositivo_id], references: [id])
  magnitud       Decimal        @db.Decimal(6,2)
  severidad      String
  latitud        Float?
  longitud       Float?
  precision_m    Float?         @db.Real
  ocurrido_en    DateTime       @db.Timestamptz(6)
  recibido_en    DateTime       @default(now()) @db.Timestamptz(6)
  clave_cliente  String

  @@unique([dispositivo_id, clave_cliente])
  @@index([ocurrido_en(sort: Desc)])
}
